{
  "name": "abhi-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "pnpm run format:check && pnpm run lint",
    "check:fix": "node scripts/biome.mjs check . --write --error-on-warnings && pnpm run format",
    "lint": "node scripts/biome.mjs lint . --error-on-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm run build && node --test"
  },
  "dependencies": {
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "oxfmt": "^0.77.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}

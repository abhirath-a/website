---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Abhi Agasanakoppa",
  description = "abhi agasanakoppa — software engineer working on machine learning, systems programming, and embedded software.",
} = Astro.props;
const homeLink = (hash: string) => Astro.url.pathname === "/" ? hash : `/${hash}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#90110b" />
    <meta
      name="description"
      content={description}
    />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  </head>
  <body>
    <a
      class="skip-link"
      href="#main"
      target="_blank"
      rel="noopener noreferrer"
      title="Opens in a new tab"
    >
      Skip to content
    </a>

    <div class="site-shell">
      <header class="site-header">
        <a
          class="identity"
          href={homeLink("#")}
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
        >
          abhi agasanakoppa
        </a>
        <nav aria-label="Main navigation">
          <a href={homeLink("#work")}  rel="noopener noreferrer" title="Opens in a new tab">
            projects
          </a>
          <a href={homeLink("#clubs")}  rel="noopener noreferrer" title="Opens in a new tab">
            clubs
          </a>
          <a href={homeLink("#about")}  rel="noopener noreferrer" title="Opens in a new tab">
            about
          </a>
          <a href="/blog" aria-current={Astro.url.pathname.replace(/\/$/, "") === "/blog" ? "page" : undefined}>blog</a>
          <a href={homeLink("#contact")}  rel="noopener noreferrer" title="Opens in a new tab">
            contact ↗
          </a>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer>
        <span>abhi agasanakoppa</span>
      </footer>
    </div>
  </body>
</html>

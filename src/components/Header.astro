---
import SunMoon from "./sunmoon.svg";

const YEAR = new Date().getFullYear();
const pathname = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "About" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
  { href: "/now", label: "Now" },
];

const navClass = (href: string) =>
  `text-sm font-medium transition-opacity
  ${
    href === "/"
      ? pathname === "/"
        ? "font-bold opacity-100"
        : "opacity-40 hover:opacity-70"
      : pathname.startsWith(href)
        ? "font-bold opacity-100"
        : "opacity-40 hover:opacity-70"
  }`;
---

<!-- Desktop Sidebar -->
<aside
  class="bg-background/5 border-border hidden border-r p-12 backdrop-blur lg:fixed lg:top-0 lg:left-0 lg:flex lg:h-screen lg:w-64 lg:flex-col lg:justify-between"
>
  <div>
    <a href="/" class="mb-16 block">
      <h1 class="text-xl font-bold tracking-tight">Abhi</h1>
    </a>

    <nav class="flex flex-col gap-1">
      {
        navLinks.map(({ href, label }) => (
          <a href={href} class:list={[...navClass(href), "py-2"]}>
            {label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="space-y-4">
    <button
      type="button"
      data-theme-toggle
      aria-label="Toggle theme"
      class="block opacity-40 transition-opacity hover:opacity-70"
    >
      <SunMoon class="size-5 transition-transform" />
    </button>

    <div class="text-xs opacity-40">{YEAR}</div>
  </div>
</aside>

<!-- Mobile Navigation -->
<nav
  class="bg-background/80 border-border fixed inset-x-0 top-0 z-50 border-b backdrop-blur lg:hidden"
>
  <div class="flex items-center justify-between px-6 py-4">
    <a href="/" class="text-lg font-bold tracking-tight">
     Abhi 
    </a>

    <button
      type="button"
      data-menu-btn
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="text-sm font-medium opacity-40 transition-opacity hover:opacity-70"
    >
      Menu
    </button>
  </div>

  <div
    id="mobile-menu"
    data-mobile-menu
    class="border-border bg-background hidden border-t px-6 py-4"
  >
    <nav class="flex flex-col gap-3">
      {
        navLinks.map(({ href, label }) => (
          <a href={href} class={navClass(href)}>
            {label}
          </a>
        ))
      }
    </nav>

    <div class="border-border mt-4 flex items-center justify-between border-t pt-3">
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle theme"
        class="opacity-40 transition-opacity hover:opacity-70"
        >
      </button>
        <SunMoon
        class="h-[1.2rem] w-[1.2rem] scale-100 rotate-0 transition-all"
        />
      <div class="text-xs opacity-40">{YEAR}</div>
    </div>
  </div>
</nav>

<script is:inline>
  (() => {
    const html = document.documentElement;

    function setTheme(dark) {
      html.classList.toggle("dark", dark);
      localStorage.setItem("theme", dark ? "dark" : "light");
    }

    const saved = localStorage.getItem("theme");

    setTheme(
      saved
        ? saved === "dark"
        : window.matchMedia("(prefers-color-scheme: dark)").matches
    );

    function toggleTheme() {
      setTheme(!html.classList.contains("dark"));
    }

    document
      .querySelectorAll("[data-theme-toggle]")
      .forEach((button) => button.addEventListener("click", toggleTheme));

    const menuBtn = document.querySelector("[data-menu-btn]");
    const menu = document.querySelector("[data-mobile-menu]");

    if (menuBtn && menu) {
      menuBtn.addEventListener("click", () => {
        const hidden = menu.classList.toggle("hidden");

        menuBtn.textContent = hidden ? "Menu" : "Close";
        menuBtn.setAttribute("aria-expanded", String(!hidden));
      });
    }
  })();
</script>

---
import Layout from "../layouts/Layout.astro";
import projects from "../projects";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog")).splice(0, 3);
---

<Layout title="About">
  <!-- About -->
  <section id="about" class="flex flex-col justify-center py-12 lg:py-20">
    <div
      class="max-w-2xl space-y-6 text-base leading-relaxed font-medium lg:text-lg"
    >
      <p>
        I’m a student focused on math and computer science, exploring problems
        at the intersection of theory and real-world systems. I combine
        analytical thinking with hands-on engineering to build projects in
        algorithms, data systems, and software.
      </p>
      <p>
        Outside of programming I spend my time reading, taking photos, and
        hiking in my spare time.
      </p>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="border-border border-t py-12 lg:py-20">
    <h3
      class="text-muted-foreground mb-8 text-sm font-bold tracking-wider uppercase lg:mb-12"
    >
      Selected Work
    </h3>
    <div class="space-y-8">
      {
        projects.map((project) => (
          <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
            <div class="flex-1">
              <h4 class="mb-1 text-lg font-bold lg:text-xl">{project.title}</h4>
              <p class="text-muted-foreground text-sm">{project.summary}</p>
            </div>
            <span class="text-muted-foreground shrink-0 text-sm font-medium sm:ml-6">
              {project.year}
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Writing -->
  <section id="writing" class="border-border border-t py-12 lg:py-20">
    <h3
      class="text-muted-foreground mb-8 text-sm font-bold tracking-wider uppercase lg:mb-12"
    >
      Writing
    </h3>
    <div class="space-y-6">
      {
        posts.map((post) => (
          <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
            <a
              href={`#${post.slug}`}
              class="hover:text-accent-blue text-base font-medium transition-colors lg:text-lg"
            >
              {post.data.title}
            </a>
            <span class="text-muted-foreground shrink-0 text-sm sm:ml-6">
              {new Date(post.data.date).toLocaleDateString()}
            </span>
          </div>
        ))
      }
    </div>
  </section>
</Layout>

---
import { getCollection } from "astro:content";
import { type Post } from "@/content/config";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post: Post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = Post;
const {
  render: renderContent,
  data: { title, description, date },
} = Astro.props;
const { Content } = await renderContent();
---

<Layout title={title}>
  <main class="flex w-full flex-col gap-2 overflow-x-hidden">
    <header class="mb-2 flex w-full flex-col gap-3">
      <h1 class="text-4xl font-bold">{title}</h1>
      <p class="text-sm text-slate-600 dark:text-slate-300">{description}</p>
      <time class="text-slate-500 dark:text-slate-400">
        {new Date(date).toDateString()}
      </time>
    </header>
    <div class="bg-border my-2 h-[1px] w-full shrink-0"></div>
    <article
      class="prose dark:prose-invert flex w-full flex-col overflow-x-hidden md:max-w-4xl"
    >
      <Content />
    </article>
  </main>
</Layout>

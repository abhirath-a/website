---
import { getCollection, render } from "astro:content";
import Layout from "../../components/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <main class="flex w-full flex-col gap-2 overflow-x-hidden">
    <header class="mb-2 flex w-full flex-col gap-3">
      <h1 class="text-4xl font-bold">{post.data.title}</h1>
      <!-- <p class="text-sm text-slate-600 dark:text-slate-300">{post.data.description}</p> -->
      <time class="text-slate-500 dark:text-slate-400">
        {new Date(post.data.date).toDateString()}
      </time>
    </header>
    <div class="bg-border my-2 h-[1px] w-full shrink-0"></div>
    <article
      class="prose dark:prose-invert flex w-full flex-col overflow-x-hidden md:max-w-4xl"
    >
      <Content />
    </article>
  </main>
</Layout>

---
interface Props {
  frontmatter?: {
    title: string;
    prose: boolean;
  };
  title?: string;
}

import "../styles/globals.css";
import "@fontsource-variable/inter";
import Header from "@/components/Header.astro";

const { title: propTitle, frontmatter } = Astro.props;

const title = propTitle ?? frontmatter?.title ?? "";
const prose = frontmatter?.prose ?? false;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Astro description" />

    <link rel="icon" href="/favicon.svg" />

    <meta name="generator" content={Astro.generator} />

    <title>{title ? `${title} · Abhirath` : "Abhirath"}</title>
  </head>

  <body class="bg-background text-foreground min-h-screen antialiased">
    <!-- Interactive background -->
    <div
      id="grid-bg"
      aria-hidden="true"
      class="grid-background pointer-events-none fixed inset-0 -z-10"
    />

    <Header />

    <main
      class:list={[
        "bg-background/5 backdrop-blur",
        "mt-16 min-h-screen",
        "w-full max-w-4xl",
        "px-6 py-20",
        "lg:mt-0 lg:ml-64 lg:px-32 lg:py-16",
        {
          "prose dark:prose-invert": prose,
        },
      ]}
    >
      <slot />
    </main>

    <script is:inline>
      (() => {
        const bg = document.getElementById("grid-bg");
        if (!bg) return;

        let mouseX = innerWidth / 2;
        let mouseY = innerHeight / 2;
        let frame = 0;

        const update = () => {
          bg.style.setProperty("--mouse-x", `${mouseX}px`);
          bg.style.setProperty("--mouse-y", `${mouseY}px`);
          frame = 0;
        };

        addEventListener(
          "pointermove",
          (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;

            if (!frame) frame = requestAnimationFrame(update);
          },
          { passive: true }
        );
      })();
    </script>
  </body>
</html>

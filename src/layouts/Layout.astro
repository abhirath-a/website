---
interface Props {
  frontmatter?: { title: string; prose: boolean };
  title?: string;
}

const { title: propTitle, frontmatter } = Astro.props;

const title = propTitle ?? frontmatter?.title ?? "";

import "../styles/globals.css";
import "@fontsource-variable/inter";
import Header from "@/components/Header.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>
      {title} - Abhirath
    </title>
  </head>
  <body class="bg-background text-foreground relative min-h-screen">
    <div id="grid-bg" class="grid-background fixed inset-0 z-0" />
    <Header />

    <main
      class:list={[
        "bg-background/5 mt-16 min-h-full w-full max-w-4xl px-6 py-20 backdrop-blur-xs lg:mt-0 lg:ml-64 lg:py-16 lg:pr-16 lg:pl-32",
        { "prose dark:prose-invert": frontmatter?.prose ?? false },
      ]}
    >
      <slot />
    </main>

    <script is:inline>
      const gridBg = document.getElementById("grid-bg");
      document.addEventListener("mousemove", (e) => {
        gridBg.style.setProperty("--mouse-x", e.clientX + "px");
        gridBg.style.setProperty("--mouse-y", e.clientY + "px");
      });
    </script>
  </body>
</html>
